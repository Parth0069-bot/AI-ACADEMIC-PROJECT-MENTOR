SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Semantic Router / Mixture-of-Models tiers
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_DEEP=gemini-3.1-pro
SEMANTIC_ROUTER_ENABLED=true
SEMANTIC_ROUTER_CONFIDENCE_THRESHOLD=0.35
SEMANTIC_ROUTER_DEFAULT_TIER=fast
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CHUNK_SIZE=220
EMBEDDING_CHUNK_OVERLAP=40
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
EVALUATION_ENABLED=true
JUDGE_MODEL=gemini-3.1-pro
EVALUATION_FLAG_THRESHOLD=60

# Long-term agent memory (mem0ai). This is a DIRECT Postgres connection
# string, not the same as SUPABASE_URL above -- find it in the Supabase
# dashboard under Project Settings -> Database -> Connection string (URI).
# Use the pooled "Transaction" connection string if you're on a
# serverless/short-lived-process deployment.
SUPABASE_DB_CONNECTION_STRING=postgresql://postgres:[YOUR-DB-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
MEM0_COLLECTION_NAME=academic_mentor_memories
MEMORY_RETRIEVAL_LIMIT=6
MEMORY_ENABLED=true
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
